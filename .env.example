# Core runtime
PYTHONUNBUFFERED=1
TZ=UTC

# Dataset and outputs
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODEL_DIR=./models
LOG_DIR=./logs

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=network-telemetry
KAFKA_MAX_OFFSETS_PER_TRIGGER=10000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nids
MONGODB_INCIDENTS_COLLECTION=security_incidents
MONGODB_CAMPAIGNS_COLLECTION=attack_campaigns

# Streaming defaults
TRIGGER_INTERVAL_SECONDS=5
CAMPAIGN_WINDOW=5 minutes
CAMPAIGN_SLIDE=1 minute
CAMPAIGN_MIN_EVENTS=10
